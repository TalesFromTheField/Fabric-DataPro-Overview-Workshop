{
  "servers": {

    // ── Author tools ─────────────────────────────────────────────
    // GitHub: manage PRs, issues, and repo operations
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp"
    },

    // Markdown: TOC generation, linting, formatting, stats
    "markdown-tools": {
      "command": "npx",
      "args": ["-y", "@rog0x/mcp-markdown-tools@latest"]
    },

    // ── Fabric servers ───────────────────────────────────────────
    // Fabric Local: API specs, item schemas, best practices (no live connection)
    "fabric-local": {
      "command": "npx",
      "args": ["-y", "@microsoft/fabric-mcp@latest", "server", "start", "--mode", "all"]
    },

    // Fabric Core: live interaction with Fabric workspaces, items, permissions
    // Requires Microsoft Entra ID authentication (browser sign-in flow)
    "fabric-core": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/core"
    },

    // ── Azure & reference tools ──────────────────────────────────
    // Azure: manage Azure subscriptions, resources, storage, etc.
    // Requires: az login
    "azure": {
      "command": "npx",
      "args": ["-y", "@azure/mcp@latest", "server", "start"]
    },

    // Microsoft Learn: search official docs, fetch articles, find code samples
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },

    // Fetch: retrieve any web page or documentation URL
    "fetch": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-fetch@latest"]
    }
  }
}
